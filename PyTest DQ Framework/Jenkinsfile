pipeline {
    agent any

    stages {
        stage('Install dependencies') {
            steps {
                dir('PyTest DQ Framework') {
                    sh '''
                        apt-get update
                        apt-get install -y \
                            build-essential \
                            libpq-dev \
                            python3 \
                            python3-dev \
                            python3-pip \
                            python3-venv
                        python3 -m venv .venv
                        .venv/bin/python -m pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Run Parquet DQ tests') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'POSTGRES_SECRET',
                        usernameVariable: 'POSTGRES_USER',
                        passwordVariable: 'POSTGRES_PASSWORD'
                    )
                ]) {
                    dir('PyTest DQ Framework') {
                        sh '''
                            mkdir -p html_report
                            .venv/bin/python -m pytest tests -m "parquet_data" \
                                --db_host="postgres" \
                                --db_port="5432" \
                                --db_name="mydatabase" \
                                --db_user="$POSTGRES_USER" \
                                --db_password="$POSTGRES_PASSWORD" \
                                --html=html_report/report.html
                        '''
                    }
                }
            }
            post {
                always {
                    dir('PyTest DQ Framework') {
                        archiveArtifacts(
                            artifacts: 'html_report/**',
                            allowEmptyArchive: true
                        )
                        publishHTML(target: [
                            allowMissing: true,
                            keepAll: true,
                            reportDir: 'html_report',
                            reportFiles: 'report.html',
                            reportName: 'HTML Test Report'
                        ])
                    }
                }
            }
        }
    }
}
